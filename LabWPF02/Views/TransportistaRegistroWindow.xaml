<Window x:Class="LabWPF02.Views.TransportistaRegistroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Transportista" Height="460" Width="480"
        WindowStartupLocation="CenterScreen">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="{StaticResource ColorPrimario}">
			<Grid Margin="20,0">
				<TextBlock Text="🚚 Registro de Transportista" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
				<Button Width="40" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="1" BorderBrush="White"
                        Click="BtnVolver_Click">
					<TextBlock Text="←" Foreground="White" FontSize="16" FontWeight="Bold"/>
				</Button>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<Border Style="{StaticResource CardBorder}" Margin="20">
				<StackPanel>
					<TextBlock Text="🏢 Nombre de Empresa" Margin="0,0,0,3"/>
					<TextBox x:Name="txtNombreEmpresa" Height="38" Margin="0,0,0,14"/>

					<TextBlock Text="🪪 RUC" Margin="0,0,0,3"/>
					<TextBox x:Name="txtRuc" Height="38" Margin="0,0,0,14" MaxLength="11"/>

					<TextBlock Text="📞 Teléfono" Margin="0,0,0,3"/>
					<TextBox x:Name="txtTelefono" Height="38" Margin="0,0,0,14" MaxLength="9"/>

					<TextBlock Text="📍 Dirección" Margin="0,0,0,3"/>
					<TextBox x:Name="txtDireccion" Height="38" Margin="0,0,0,22"/>

					<Button Content="💾 Guardar" Height="42" Click="BtnGuardar_Click"/>
				</StackPanel>
			</Border>
		</ScrollViewer>
	</Grid>
</Window>