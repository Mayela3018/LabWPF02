<Window x:Class="LabWPF02.Views.IngresoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Ingreso" Height="600" Width="720"
        WindowStartupLocation="CenterScreen">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="{StaticResource ColorPrimario}">
			<Grid Margin="20,0">
				<TextBlock Text="📥 Registro de Ingreso" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
				<Button Width="40" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="1" BorderBrush="White"
                        Click="BtnVolver_Click">
					<TextBlock Text="←" Foreground="White" FontSize="16" FontWeight="Bold"/>
				</Button>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<Border Style="{StaticResource CardBorder}" Margin="20">
				<StackPanel>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="24"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<TextBlock Text="🪪 Tipo de Documento" Margin="0,0,0,3"/>
							<ComboBox x:Name="cmbTipoDocumento" Margin="0,0,0,12" SelectionChanged="CmbTipoDocumento_SelectionChanged">
								<ComboBoxItem Content="DNI"/>
								<ComboBoxItem Content="RUC"/>
								<ComboBoxItem Content="Carnet de Extranjería"/>
							</ComboBox>

							<TextBlock Text="🔢 Número de Documento" Margin="0,0,0,3"/>
							<TextBox x:Name="txtNumeroDocumento" Margin="0,0,0,3"
                                     PreviewTextInput="TxtNumeroDocumento_PreviewTextInput"/>
							<TextBlock x:Name="txtAyudaDocumento" Text="Selecciona un tipo de documento primero"
                                       FontSize="10" FontWeight="Normal" Foreground="#7F98A8" Margin="0,0,0,12" TextWrapping="Wrap"/>

							<TextBlock Text="🚗 Placa" Margin="0,0,0,3"/>
							<TextBox x:Name="txtPlaca" Margin="0,0,0,12"/>

							<TextBlock Text="⏰ Turno" Margin="0,0,0,3"/>
							<ComboBox x:Name="cmbTurno" Margin="0,0,0,0">
								<ComboBoxItem Content="Mañana"/>
								<ComboBoxItem Content="Tarde"/>
								<ComboBoxItem Content="Noche"/>
							</ComboBox>
						</StackPanel>

						<StackPanel Grid.Column="2">
							<TextBlock Text="🧑‍✈️ Nombre del Conductor" Margin="0,0,0,3"/>
							<TextBox x:Name="txtNombreConductor" Margin="0,0,0,12"/>

							<TextBlock Text="🏢 Nombre del Cliente" Margin="0,0,0,3"/>
							<TextBox x:Name="txtNombreCliente" Margin="0,0,0,12"/>

							<TextBlock Text="📦 Producto" Margin="0,0,0,3"/>
							<TextBox x:Name="txtProducto" Margin="0,0,0,12"/>

							<TextBlock Text="🚚 Transporte" Margin="0,0,0,3"/>
							<TextBox x:Name="txtTransporte" Margin="0,0,0,0"/>
						</StackPanel>
					</Grid>

					<Grid Margin="0,18,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="16"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="16"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<TextBlock Text="📅 Fecha" Margin="0,0,0,3"/>
							<DatePicker x:Name="dpFecha"/>
						</StackPanel>

						<StackPanel Grid.Column="2">
							<TextBlock Text="🕐 Hora (HH:mm)" Margin="0,0,0,3"/>
							<TextBox x:Name="txtHora" Text="00:00"/>
						</StackPanel>

						<StackPanel Grid.Column="4">
							<TextBlock Text="⚖️ Peso (kg)" Margin="0,0,0,3"/>
							<TextBox x:Name="txtPeso"/>
						</StackPanel>
					</Grid>

					<Button Content="💾 Guardar Ingreso" Height="42" Margin="0,22,0,0" Click="BtnGuardar_Click"/>
				</StackPanel>
			</Border>
		</ScrollViewer>
	</Grid>
</Window>