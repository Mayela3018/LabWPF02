<Window x:Class="LabWPF02.Views.TransportistaListaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista de Transportistas" Height="450" Width="650"
        WindowStartupLocation="CenterScreen">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="{StaticResource ColorPrimario}">
			<Grid Margin="20,0">
				<TextBlock Text="📋 Lista de Transportistas" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
				<Button Width="40" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="1" BorderBrush="White"
                        Click="BtnVolver_Click">
					<TextBlock Text="←" Foreground="White" FontSize="16" FontWeight="Bold"/>
				</Button>
			</Grid>
		</Border>

		<Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="20">
			<DataGrid x:Name="dgTransportistas" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="🏢 Empresa" Binding="{Binding NombreEmpresa}" Width="*"/>
					<DataGridTextColumn Header="🪪 RUC" Binding="{Binding Ruc}" Width="*"/>
					<DataGridTextColumn Header="📞 Teléfono" Binding="{Binding Telefono}" Width="*"/>
					<DataGridTextColumn Header="📍 Dirección" Binding="{Binding Direccion}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Window>