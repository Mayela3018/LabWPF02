<Window x:Class="LabWPF02.Views.ReporteSalidasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de Salidas" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="60"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="{StaticResource ColorPrimario}">
			<Grid Margin="20,0">
				<TextBlock Text="📉 Reporte de Salidas" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
				<Button Width="40" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="1" BorderBrush="White"
                        Click="BtnVolver_Click">
					<TextBlock Text="←" Foreground="White" FontSize="16" FontWeight="Bold"/>
				</Button>
			</Grid>
		</Border>

		<Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="20,15,20,10">
			<StackPanel>
				<TextBlock Text="🔍 Filtros de búsqueda" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
				<WrapPanel>
					<StackPanel Margin="0,0,10,5">
						<TextBlock Text="📅 Fecha Inicio"/>
						<DatePicker x:Name="dpFechaInicio" Width="130"/>
					</StackPanel>
					<StackPanel Margin="0,0,10,5">
						<TextBlock Text="📅 Fecha Fin"/>
						<DatePicker x:Name="dpFechaFin" Width="130"/>
					</StackPanel>
					<StackPanel Margin="0,0,10,5">
						<TextBlock Text="🚗 Placa"/>
						<TextBox x:Name="txtFiltroPlaca" Width="100"/>
					</StackPanel>
					<StackPanel Margin="0,0,10,5">
						<TextBlock Text="🧑‍✈️ Conductor"/>
						<TextBox x:Name="txtFiltroConductor" Width="140"/>
					</StackPanel>
					<StackPanel Margin="0,0,10,5">
						<TextBlock Text="📦 Producto"/>
						<TextBox x:Name="txtFiltroProducto" Width="120"/>
					</StackPanel>
					<StackPanel VerticalAlignment="Bottom" Margin="0,0,0,5">
						<Button Content="🔍 Buscar" Width="100" Height="30" Click="BtnBuscar_Click"/>
					</StackPanel>
				</WrapPanel>
			</StackPanel>
		</Border>

		<Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="20,0,20,20">
			<DataGrid x:Name="dgSalidas" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="📅 Fecha" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
					<DataGridTextColumn Header="🚗 Placa" Binding="{Binding Placa}" Width="*"/>
					<DataGridTextColumn Header="⏰ Turno" Binding="{Binding Turno}" Width="*"/>
					<DataGridTextColumn Header="🧑‍✈️ Conductor" Binding="{Binding NombreConductor}" Width="*"/>
					<DataGridTextColumn Header="📦 Producto" Binding="{Binding Producto}" Width="*"/>
					<DataGridTextColumn Header="⚖️ Peso" Binding="{Binding PesoSalida}" Width="*"/>
					<DataGridTextColumn Header="🚚 Transporte" Binding="{Binding Transporte}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>
</Window>