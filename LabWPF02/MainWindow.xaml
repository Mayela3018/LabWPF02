<Window x:Class="LabWPF02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="520" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="380"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0" Background="White" Margin="50,0">
			<StackPanel VerticalAlignment="Center">
				<TextBlock Text="🚛" FontSize="42" Margin="0,0,0,10"/>
				<TextBlock Text="Bienvenido de nuevo" FontSize="26" FontWeight="Bold" Margin="0,0,0,4"/>
				<TextBlock Text="Ingresa tus credenciales para continuar" FontSize="12" FontWeight="Normal"
                           Foreground="#7F98A8" Margin="0,0,0,30" TextWrapping="Wrap"/>

				<TextBlock Text="👤 Usuario" Margin="0,0,0,5"/>
				<TextBox x:Name="txtUsuario" Height="40" Margin="0,0,0,18"/>

				<TextBlock Text="🔒 Contraseña" Margin="0,0,0,5"/>
				<Grid Margin="0,0,0,6">
					<PasswordBox x:Name="txtPassword" Height="40"/>
					<TextBox x:Name="txtPasswordVisible" Height="40" Visibility="Collapsed"/>
					<ToggleButton x:Name="btnMostrarPassword" Content="👁" Width="32" Height="28"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                  Background="Transparent" BorderThickness="0"
                                  Checked="BtnMostrarPassword_Checked" Unchecked="BtnMostrarPassword_Unchecked"/>
				</Grid>

				<TextBlock Text="Se bloqueará el acceso tras 3 intentos fallidos" FontSize="10" FontWeight="Normal"
                           Foreground="#A9C0BC" Margin="0,0,0,22"/>

				<Button x:Name="btnIngresar" Content="Ingresar" Height="44" FontSize="14" Click="BtnIngresar_Click"/>

				<TextBlock Text="Sistema de Control de Ingresos © 2026" FontSize="10" FontWeight="Normal"
                           Foreground="#A9C0BC" HorizontalAlignment="Center" Margin="0,32,0,0"/>
			</StackPanel>
		</Grid>

		<Grid Grid.Column="1">
			<Grid.Background>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="#213A58" Offset="0"/>
					<GradientStop Color="#0C6478" Offset="0.55"/>
					<GradientStop Color="#09D1C7" Offset="1"/>
				</LinearGradientBrush>
			</Grid.Background>

			<Ellipse Width="220" Height="220" Fill="#2646DFB1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-60,0"/>
			<Ellipse Width="160" Height="160" Fill="#1580EE98" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-40,0,0,-40"/>

			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
				<TextBlock Text="📦🚚📊" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,20"/>
				<TextBlock Text="Gestiona tus operaciones" FontSize="24" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
				<TextBlock Text="logísticas en un solo lugar" FontSize="24" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,15"/>
				<TextBlock Text="Ingresos, salidas, conductores, transportistas, camiones, productos y reportes, todo centralizado."
                           FontSize="12" FontWeight="Normal" Foreground="#D6F5F1"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="300"/>
			</StackPanel>
		</Grid>
	</Grid>
</Window>